# Caddy fetches and renews a Let's Encrypt certificate for APP_DOMAIN
# automatically, and reverse-proxies HTTPS traffic to the app container.
# APP_DOMAIN comes from .env.production (e.g. crm.italprotein.com).
{$APP_DOMAIN} {
	encode zstd gzip
	root * /srv/error-pages

	reverse_proxy app:3000 {
		# If the application responds with a gateway/service failure of its own,
		# replace only the response body with the branded recovery page while
		# preserving the original HTTP status code.
		@upstream_failure status 502 503 504
		handle_response @upstream_failure {
			rewrite /502.html
			header Cache-Control "no-store, max-age=0"
			header X-Robots-Tag "noindex, nofollow"
			file_server
		}

		# Next.js builds absolute URLs for redirects from the incoming request
		# (e.g. NextResponse.redirect(new URL(path, request.url))). Without the
		# original host and scheme forwarded, it resolves them against the
		# container's own bind address and emits Location: https://0.0.0.0:3000/…,
		# which a browser cannot follow — this broke the Google OAuth round-trip.
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	# Connection failures happen before Next.js can render anything. Caddy serves
	# the same self-contained page directly for those transport-level failures.
	handle_errors 502 503 504 {
		rewrite /502.html
		header Cache-Control "no-store, max-age=0"
		header X-Robots-Tag "noindex, nofollow"
		file_server
	}
}
