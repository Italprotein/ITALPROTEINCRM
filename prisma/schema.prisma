model Shipment {
  id                      String         @id @default(cuid())
  reference               String         @unique
  sampleRequestId         String
  companyId               String
  senderLocation          String
  recipient               String
  address                 Json
  phone                   String?
  email                   String?
  courier                 String?
  service                 String?
  trackingNumber          String?
  trackingUrl             String?
  shipmentDate            DateTime?
  estimatedDelivery       DateTime?
  actualDelivery          DateTime?
  packageCount            Int?
  weightKg                Decimal?
  dimensions              String?
  shippingCost            Int?
  currency                Currency       @default(EUR)
  customsStatus           CustomsStatus?
  incoterm                Incoterm?
  isExtraEU               Boolean        @default(false)
  originCountry           String?
  destinationCountry      String?
  eoriImportInfo          String?
  customsDocuments        Json?
  proofOfDelivery         Json?
  lineItems               Json?
  status                  ShipmentStatus @default(pending)
  deliveryIssue           String?
  isDelayed               Boolean        @default(false)
  /// When the DHL API was last asked about this parcel. The free tracking
  /// tier has a daily call budget, so the sync polls least-recently-checked
  /// first and skips anything asked about inside the cooldown window.
  lastTrackedAt           DateTime?
  confirmedByContactId    String?
  assignedLogisticsUserId String?
  internalNotes           String?
  clientVisibleNotes      String?
  createdById             String?
  updatedById             String?
  createdAt               DateTime       @default(now())
