/**
 * ══════════════════════════════ Identity / access models ══════════════════════════════
 */

model User {
  id                 String     @id @default(cuid())
  name               String?
  email              String?    @unique
  emailVerified      DateTime?
  image              String?
  roleId             String
  kind               UserKind   @default(internal)
  companyId          String?
  contactId          String?    @unique
  status             UserStatus @default(invited)
  passwordHash       String?
  authVersion        Int        @default(0) @map("auth_version")
  mfaEnrolled        Boolean    @default(false)
  // Set when an account is created with a password someone else chose (seeded
  // bootstrap admins, operator resets). Every guarded action refuses until the
  // owner picks their own, so a credential shared over chat or email is a
  // one-time bootstrap rather than a standing password.
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  language           Locale     @default(en)
  lastLoginAt        DateTime?
  invitedByUserId    String?
  createdById        String?
  updatedById        String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Identity-domain relations
  role                   Role                   @relation("RoleUsers", fields: [roleId], references: [id])
  company                Company?               @relation("CompanyExternalUsers", fields: [companyId], references: [id])
  contact                Contact?               @relation("UserPortalContact", fields: [contactId], references: [id])
  invitedBy              User?                  @relation("UserInvitations", fields: [invitedByUserId], references: [id])
  invitedUsers           User[]                 @relation("UserInvitations")
  accounts               Account[]              @relation("UserAccounts")
  sessions               Session[]              @relation("UserSessions")
  mfaFactors             MfaFactor[]            @relation("UserMfaFactors")
  auditEvents            AuditEvent[]           @relation("AuditEventActor")
  emailLogs              EmailLog[]             @relation("EmailLogRecipient")
  registrationDecisions  RegistrationDecision[] @relation("RegistrationDecisionDecider")
  reviewedRegistrations  Registration[]         @relation("RegistrationReviewer")
  provisionedByDecisions RegistrationDecision[] @relation("RegistrationDecisionOwnerUser")

  // Core commercial back-relations
  ownedCompanies      Company[]                 @relation("CompanyOwner")
  ownedContacts       Contact[]                 @relation("ContactOwner")
  ownedOpportunities  Opportunity[]             @relation("OpportunityOwner")
  stageHistoryEntries OpportunityStageHistory[] @relation("StageHistoryActor")

  // Operational back-relations
  assignedSampleRequests SampleRequest[]      @relation("SampleRequestLogistics")
  ownedSampleRequests    SampleRequest[]      @relation("SampleRequestAccountOwner")
  approvedSampleRequests SampleRequest[]      @relation("SampleRequestApprovedBy")
  assignedShipments      Shipment[]           @relation("ShipmentLogistics")
  shipmentEvents         ShipmentEvent[]      @relation("ShipmentEventActor")
  ownedFeedbacks         Feedback[]           @relation("FeedbackTechnicalOwner")
  feedbackComments       FeedbackComment[]    @relation("FeedbackCommentAuthorUser")
  ownedProjectsInternal  ApplicationProject[] @relation("ProjectInternalOwner")
  ownedProjectsTechnical ApplicationProject[] @relation("ProjectTechnicalOwner")

  // Documents / NDA / Google back-relations
  uploadedDocuments        Document[]            @relation("DocumentUploadedBy")
  documentAccessEvents     DocumentAccessEvent[] @relation("DocumentAccessActor")
  ndaApprovals             NDA[]                 @relation("NDAApprovedBy")
  googleOAuthTokens        GoogleOAuthToken[]    @relation("GoogleTokenUser")
  linkedDriveFiles         GoogleDriveFileLink[] @relation("DriveLinkLinkedBy")
  uploadedAttachments      Attachment[]          @relation("AttachmentUploadedBy")
  uploadedDocumentVersions DocumentVersion[]     @relation("DocumentVersionUploadedBy")

  // Finance back-relations
  approvedQuotes    Quote[]      @relation("QuoteApprovedBy")
  confirmedOrders   Order[]      @relation("OrderConfirmedBy")
  issuedInvoices    Invoice[]    @relation("InvoiceIssuedBy")
  recordedPayments  Payment[]    @relation("PaymentRecordedBy")
  issuedCreditNotes CreditNote[] @relation("CreditNoteIssuedBy")

  // Engagement / AI back-relations
  ownedTasks                Task[]             @relation("TaskOwner")
  taskComments              TaskComment[]      @relation("TaskCommentAuthor")
  collaboratingTasks        TaskCollaborator[] @relation("TaskCollaboratorUser")
  ownedMeetings             Meeting[]          @relation("MeetingOwner")
  meetingAttendances        MeetingAttendee[]  @relation("MeetingAttendeeUser")
  activities                Activity[]         @relation("ActivityActor")
  notifications             Notification[]     @relation("NotificationRecipient")
  assignedSupportRequests   SupportRequest[]   @relation("SupportRequestOwner")
  supportMessages           SupportMessage[]   @relation("SupportMessageAuthorUser")
  assistantThreads          AssistantThread[]  @relation("AssistantThreadUser")
  confirmedAssistantActions AssistantMessage[] @relation("AssistantMessageConfirmedBy")

  // Gmail-sync / lead / password-reset back-relations
  matchedEmailMessages EmailMessage[]           @relation("EmailMessageMatchedAdmin")
  leads                Lead[]                   @relation("LeadAdmin")
  passwordResetCodes   PasswordResetCode[]      @relation("UserPasswordResetCodes")
  activationTokens     AccountActivationToken[] @relation("UserAccountActivationTokens")
  doNotContactEntries  DoNotContactEntry[]      @relation("DoNotContactAddedBy")
  followUpsCreated     FollowUp[]               @relation("FollowUpCreatedBy")
  followUpsStatusSet   FollowUp[]               @relation("FollowUpStatusChangedBy")

  // Email-reconciliation registers this user seeded by hand. All SetNull:
  // deleting a staff account must never delete a domain mapping or a
  // suppression, only forget who wrote it.
  createdCompanyAliases     CompanyAlias[]     @relation("CompanyAliasCreatedBy")
  createdCompanyDomains     CompanyDomain[]    @relation("CompanyDomainCreatedBy")
  createdSuppressedEntities SuppressedEntity[] @relation("SuppressedEntityCreatedBy")

  @@index([roleId])
  @@index([companyId])
  @@index([status])
  @@index([kind])
  @@index([invitedByUserId])
  @@map("users")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation("UserAccounts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Auth.js adapter model — intentionally exempt from the id/createdAt/updatedAt
// convention. Its shape (composite @@unique([identifier, token]), no id PK, no
// updatedAt) is fixed by the NextAuth/Auth.js adapter contract.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model MfaFactor {
  id           String          @id @default(cuid())
  userId       String
  type         MfaFactorType
  status       MfaFactorStatus @default(pending)
  label        String?
  secret       String?
  credentialId String?
  lastUsedAt   DateTime?
  verifiedAt   DateTime?
  createdById  String?
  updatedById  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user User @relation("UserMfaFactors", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("mfa_factors")
}

// The roles table — role.key holds the RoleKey enum value (super_admin, ...); mapped to "roles".
model Role {
  id          String   @id @default(cuid())
  key         RoleKey  @unique
  kind        RoleKind
  name        String?
  permissions Json?
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[] @relation("RoleUsers")

  @@index([kind])
  @@map("roles")
}

model Registration {
  id                    String                @id @default(cuid())
  reference             String                @unique
  status                RegistrationStatus    @default(submitted)
  legalName             String
  tradingName           String?
  companyType           CompanyType
  companySubtype        String?
  website               String?
  country               String
  countryCode           String
  region                String?
  city                  String
  address               String?
  postalCode            String?
  vatNumber             String?
  registrationNumber    String?
  mainActivity          String?
  companySize           CompanySize?
  marketsServed         String[]
  preferredLanguage     Locale                @default(en)
  preferredCurrency     Currency              @default(EUR)
  timezone              String?
  contactFirstName      String
  contactLastName       String
  contactJobTitle       String?
  contactDepartment     String?
  contactEmail          String
  contactPhone          String?
  contactMobile         String?
  contactLanguage       Locale?
  reason                String?
  existingContactPerson String?
  intendedApplications  ApplicationCategory[]
  productCategories     ApplicationCategory[]
  samplesRequested      Boolean?
  intendedTerritories   String[]
  estimatedTimeline     String?
  additionalMessage     String?
  privacyAccepted       Boolean               @default(false)
  termsAccepted         Boolean               @default(false)
  marketingOptIn        Boolean?
  linkedCompanyId       String?
  adminNote             String?
  decidedByUserId       String?
  decidedAt             DateTime?
  createdById           String?
  updatedById           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  decidedByUser User?                  @relation("RegistrationReviewer", fields: [decidedByUserId], references: [id])
  linkedCompany Company?               @relation("RegistrationLinkedCompany", fields: [linkedCompanyId], references: [id])
  decisions     RegistrationDecision[] @relation("RegistrationDecisions")

  @@index([status])
  @@index([contactEmail])
  @@index([linkedCompanyId])
  @@index([decidedByUserId])
  @@index([companyType])
  @@map("registrations")
}

model RegistrationDecision {
  id                     String                   @id @default(cuid())
  registrationId         String
  decision               RegistrationDecisionType
  reason                 String?
  note                   String?
  decidedByUserId        String
  decidedAt              DateTime                 @default(now())
  provisionedCompanyId   String?
  provisionedContactId   String?
  provisionedOwnerUserId String?
  createdById            String?
  updatedById            String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  registration         Registration @relation("RegistrationDecisions", fields: [registrationId], references: [id])
  decidedByUser        User         @relation("RegistrationDecisionDecider", fields: [decidedByUserId], references: [id])
  provisionedCompany   Company?     @relation("RegistrationDecisionCompany", fields: [provisionedCompanyId], references: [id])
  provisionedContact   Contact?     @relation("RegistrationDecisionContact", fields: [provisionedContactId], references: [id])
  provisionedOwnerUser User?        @relation("RegistrationDecisionOwnerUser", fields: [provisionedOwnerUserId], references: [id])

  @@index([registrationId])
  @@index([decidedByUserId])
  @@index([provisionedCompanyId])
  @@index([provisionedOwnerUserId])
  @@index([decision])
  @@map("registration_decisions")
}

model AuditEvent {
  id          String      @id @default(cuid())
  actorUserId String?
  actorRole   RoleKey?
  action      String
  entityType  String
  entityId    String?
  summary     String
  before      Json?
  after       Json?
  result      AuditResult @default(success)
  ip          String?
  userAgent   String?
  companyId   String?
  occurredAt  DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  actorUser User? @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([companyId])
  @@index([result])
  @@index([occurredAt])
  @@map("audit_events")
}

model EmailLog {
  id                String           @id @default(cuid())
  trigger           NotificationType
  templateKey       String?
  to                String
  toAddresses       String[]
  cc                String[]
  subject           String
  preview           String?
  locale            Locale           @default(en)
  status            EmailLogStatus   @default(queued)
  providerMessageId String?
  error             String?
  attemptCount      Int              @default(0)
  recipientUserId   String?
  companyId         String?
  relatedEntityType String?
  relatedEntityId   String?
  sentAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  recipientUser User? @relation("EmailLogRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([trigger])
  @@index([status])
  @@index([recipientUserId])
  @@index([companyId])
  @@index([relatedEntityType, relatedEntityId])
  @@map("email_logs")
}

/**
 * ══════════════════════════════ Core commercial models ══════════════════════════════
 */

model Company {
  id                            String                @id @default(cuid())
  legalName                     String
  tradingName                   String?
  aliases                       String[]
  type                          CompanyType
  subtype                       String?
  segment                       CommercialSegment?
  description                   String?
  website                       String?
  linkedin                      String?
  vatNumber                     String?
  registrationNumber            String?
  logoUrl                       String?
  // Logo provenance. `logoSource` records where logoUrl came from ("favicon"
  // today); `logoVerified` marks a logo a human has approved, which the
  // automated importer must never overwrite; `logoUpdatedAt` doubles as the
  // "has a logo" flag on the list DTO and as the ETag for /api/companies/[id]/logo.
  logoSource                    String?
  logoVerified                  Boolean               @default(false)
  logoUpdatedAt                 DateTime?
  initials                      String
  accentColor                   String?
  headquarters                  Json
  additionalLocations           Json?
  billingAddress                Json?
  shippingAddresses             Json?
  country                       String
  countryCode                   String
  city                          String
  region                        String?
  timezone                      String?
  preferredLanguage             Locale                @default(en)
  preferredCurrency             Currency              @default(EUR)
  size                          CompanySize?
  marketsServed                 String[]
  mainActivity                  String?
  leadSource                    FirstContactChannel?
  firstContact                  Json
  territory                     String?
  distributionMarkets           String[]
  cooperationModel              CooperationModel?
  relationshipStage             RelationshipStage     @default(lead)
  leadScore                     Int?
  probability                   Int?
  priority                      Priority              @default(medium)
  ndaStatus                     NDAStatus?
  latestSampleStatus            SampleStatus?
  productCategories             ApplicationCategory[]
  applicationInterests          String[]
  estimatedAnnualPotentialMinor Int?
  opportunityValueMinor         Int?
  commercialNotes               String?
  logisticsRequirements         String?
  preferredCourier              String?
  deliveryInstructions          String?
  customsInfo                   String?
  paymentTerms                  String?
  tags                          String[]
  lastActivityAt                DateTime?
  /// When Apollo last enriched this row. The pass orders by it (nulls first)
  /// and skips anything inside the cooldown, so a metered plan is spent on
  /// companies nobody has looked up rather than on the same few repeatedly.
  enrichedAt                    DateTime?
  nextAction                    Json?
  ownerUserId                   String
  supportingTeamUserIds         String[]
  createdById                   String?
  updatedById                   String?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt

  owner User @relation("CompanyOwner", fields: [ownerUserId], references: [id])

  contacts               Contact[]
  opportunities          Opportunity[]
  externalUsers          User[]                 @relation("CompanyExternalUsers")
  linkedRegistrations    Registration[]         @relation("RegistrationLinkedCompany")
  provisionedByDecisions RegistrationDecision[] @relation("RegistrationDecisionCompany")

  // Operational
  sampleRequests      SampleRequest[]
  shipments           Shipment[]
  feedbacks           Feedback[]
  applicationProjects ApplicationProject[]

  // Documents / NDA / Google
  ndas                 NDA[]
  emailMessages        EmailMessage[]        @relation("CompanyEmailMessages")
  documents            Document[]
  googleDriveFileLinks GoogleDriveFileLink[]

  // Finance
  quotes      Quote[]      @relation("CompanyQuotes")
  orders      Order[]      @relation("CompanyOrders")
  invoices    Invoice[]    @relation("CompanyInvoices")
  creditNotes CreditNote[] @relation("CompanyCreditNotes")

  // Engagement / AI
  tasks                 Task[]            @relation("CompanyTasks")
  meetings              Meeting[]         @relation("CompanyMeetings")
  activities            Activity[]        @relation("CompanyActivities")
  notifications         Notification[]    @relation("NotificationSubjectCompany")
  audienceNotifications Notification[]    @relation("NotificationAudienceCompany")
  supportRequests       SupportRequest[]  @relation("CompanySupportRequests")
  assistantThreads      AssistantThread[] @relation("AssistantThreadCompany")

  // Do-not-contact register (at most one entry per company — companyId is unique).
  doNotContact DoNotContactEntry? @relation("CompanyDoNotContact")

  // Follow-up register (at most one open row per company).
  followUp FollowUp? @relation("CompanyFollowUp")

  // Email reconciliation registers. `aliasEntries` is the normalized, matchable
  // form of the free-text `aliases` array above; `domains` is what the Gmail
  // sync matches a sender's registrable domain against.
  aliasEntries CompanyAlias[]  @relation("CompanyAliases")
  domains      CompanyDomain[] @relation("CompanyDomains")

  @@index([type])
  @@index([segment])
  @@index([country])
  @@index([relationshipStage])
  @@index([ownerUserId])
  @@index([priority])
  @@index([enrichedAt])
  @@map("companies")
}

/// Companies nobody may contact, maintained by hand from /admin/do-not-contact.
///
/// `companyId` is UNIQUE: a company is either on the list or it is not, so
/// re-adding one updates its reason/notes instead of creating a rival entry
/// that could disagree with the badge on the company record. The FK cascades —
/// once the company row is gone there is nobody left to protect — while
/// `addedById` is SetNull so deleting a staff account never deletes a
/// suppression.
model DoNotContactEntry {
  id        String             @id @default(cuid())
  companyId String             @unique
  reason    DoNotContactReason
  notes     String?
  addedById String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  company Company @relation("CompanyDoNotContact", fields: [companyId], references: [id], onDelete: Cascade)
  addedBy User?   @relation("DoNotContactAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([reason])
  @@index([addedById])
  @@map("do_not_contact_entries")
}

/// The follow-up register: who we owe a reply to, and when.
///
/// Two very different things share this table on purpose, distinguished by
/// `source`:
///
///  1. Companies that have simply gone quiet. The sync pass
///     (lib/backend/follow-up-register.ts) writes one `quiet_detection` row per
///     company that has been silent longer than FOLLOW_UP_AFTER_DAYS.
///  2. Dated decisions — the October 2026 outreach freeze, and anything a
///     person adds by hand with a date.
///
/// They belong together because the question the page answers is the same for
/// both: *who may I contact today, and who must I leave alone until when.*
/// Splitting them would mean reading two lists to answer it.
///
/// `companyId` is nullable because the suppression list names counterparties
/// that have no company record yet (Pathway International, Verve, Biota
/// Ingredients …). Losing that row would lose the instruction, so the name is
/// stored on the row itself and the link is optional. It is UNIQUE where set:
/// one open follow-up per company, so the page can never show a company twice
/// with contradictory dates. `normalizedName` is indexed but deliberately NOT
/// unique — production already holds two companies that normalize to
/// "charles alice", and a constraint here would reject the second one.
model FollowUp {
  id             String         @id @default(cuid())
  companyId      String?        @unique
  /// Display name, snapshotted. Authoritative for rows with no companyId.
  companyName    String
  /// Matchable form of companyName, for de-duplicating imports.
  normalizedName String
  domain         String?
  status         FollowUpStatus @default(pending)
  source         FollowUpSource @default(manual)
  /// The date the freeze lifts, or the day someone chose to pick this back up.
  /// A plain date, not an instant: "11 October" must not shift by timezone.
  followUpOn        DateTime?  @db.Date
  /// Why this row exists, in the words of whoever decided it.
  reason            String?
  notes             String?
  /// Snapshot from the last sync — what the arithmetic saw.
  lastContactAt     DateTime?
  quietDays         Int?
  statusChangedAt   DateTime?
  statusChangedById String?
  createdById       String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  company         Company? @relation("CompanyFollowUp", fields: [companyId], references: [id], onDelete: Cascade)
  statusChangedBy User?    @relation("FollowUpStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: SetNull)
  createdBy       User?    @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([source])
  @@index([followUpOn])
  @@index([normalizedName])
  @@map("follow_ups")
}


/// An investor-outreach target: the funds, angel networks and holdings
/// contacted for the Proamina raise, imported from the campaign workbook and
/// maintained from /admin/investors.
///
/// Deliberately its OWN table, not a Company row: the company machinery
/// (samples, shipments, NDAs, pipeline stages) must never attach to an
/// investor, and the Gmail sync / reconciliation must never see one as a
/// commercial company. `name` is UNIQUE so the importer's upsert makes re-runs
/// update rows instead of duplicating them.
model Investor {
  id             String         @id @default(cuid())
  name           String         @unique
  status         InvestorStatus @default(first_contact)
  emails         String[]       @default([])
  country        String?
  city           String?
  domain         String?
  firstContactAt DateTime?
  lastContactAt  DateTime?
  /// "Tipo di riscontro" — how the current status was determined.
  responseType   String?
  /// "Dettagli / prossimo passo" — free-text next step from the campaign sheet.
  nextStep       String?
  /// Deep link to the Gmail thread the status was read from.
  gmailUrl       String?
  notes          String?
  /// Favicon logo, same shape as Company: bytes stored as a data URI; the
  /// timestamp doubles as the client's "there is a logo" flag and cache-buster.
  logoUrl        String?
  logoUpdatedAt  DateTime?
  createdById    String?
  updatedById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([country])
  @@index([domain])
  @@map("investors")
}

/// Every name one company is known by, in a form two strings can be compared in.
///
/// Company.aliases is a free-text String[] a person types into a form; it is
/// fine for display and useless for matching, because "Regal Cream Products
/// Pty. Ltd." and "regal cream products pty ltd" are the same organisation and
/// two different strings. `normalizedName` (lib/email-entity.ts) is the
/// comparable form, and the Gmail sync looks a sender's company name up here
/// before it considers creating anything.
///
/// The unique key is (companyId, normalizedName), NOT normalizedName alone: two
/// unrelated companies genuinely do share a trading name across markets, and a
/// global unique would make the second one unsaveable. The plain index on
/// normalizedName is what keeps the cross-company lookup cheap; when it returns
/// more than one row the sync treats the name as ambiguous and links nothing.
model CompanyAlias {
  id             String           @id @default(cuid())
  companyId      String
  name           String
  normalizedName String
  kind           CompanyAliasKind
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company   Company @relation("CompanyAliases", fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("CompanyAliasCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([companyId, normalizedName])
  @@index([normalizedName])
  @@index([companyId])
  @@index([createdById])
  @@map("company_aliases")
}

/// The email domains that belong to a company — the idempotency backbone of
/// Gmail reconciliation.
///
/// `domain` is UNIQUE across the whole table on purpose, and that constraint is
/// what makes auto-creation race-proof: two sync runs processing two messages
/// from the same new domain at the same moment cannot both win, because the
/// second INSERT fails and its transaction rolls back to a lookup. Production
/// held four "Pphosted" companies created in one day precisely because nothing
/// anywhere said "this domain is already taken".
///
/// Domains are stored in their registrable form (pphosted.com, bulla.com.au),
/// never as the per-message bounce host that produced them.
///
/// `verified` defaults to true because every writer today has evidence — an
/// import, an operator, or a message that actually arrived. It exists so a
/// future guessed domain can be stored without being trusted for matching.
model CompanyDomain {
  id          String              @id @default(cuid())
  companyId   String
  domain      String              @unique
  verified    Boolean             @default(true)
  source      CompanyDomainSource
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  company   Company @relation("CompanyDomains", fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("CompanyDomainCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([createdById])
  @@map("company_domains")
}

/// Domains, addresses and names the Gmail sync must never turn into anything.
///
/// This is its own table rather than a column on Lead because
/// reconcileStoredLeadOwnership DELETES and rebuilds every gmail-source lead on
/// each run: a "never again" flag stored there would be wiped by the next sync,
/// and the entity it suppressed would walk straight back in. Suppression has to
/// outlive the rows it is about.
///
/// It is also separate from DoNotContactEntry, which suppresses OUTBOUND
/// contact with a company that exists. This one suppresses INBOUND
/// interpretation of mail from something that must never become a company at
/// all — a bounce handler, a relay, a courier. Different subject, different
/// lifetime, different table.
///
/// `normalizedValue` carries the comparable form (registrable domain, lowercased
/// address, normalized name) and is half of the unique key, so re-adding an
/// entry updates it instead of stacking duplicates.
model SuppressedEntity {
  id              String               @id @default(cuid())
  kind            SuppressedEntityKind
  value           String
  normalizedValue String
  reason          String?
  createdById     String?
  createdAt       DateTime             @default(now())

  createdBy User? @relation("SuppressedEntityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([kind, normalizedValue])
  @@index([kind])
  @@index([createdById])
  @@map("suppressed_entities")
}

model Contact {
  id                       String        @id @default(cuid())
  companyId                String
