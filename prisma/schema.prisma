/**
 * ══════════════════════════════ Operational models ══════════════════════════════
 */

model SampleRequest {
  id                      String              @id @default(cuid())
  reference               String              @unique
  companyId               String
  contactId               String?
  opportunityId           String?
  projectId               String?
  applicationCategory     ApplicationCategory
  requestedProduct        String
  testObjective           String?
  requestedQuantity       Decimal
  approvedQuantity        Decimal?
  unit                    QuantityUnit
  lotBatch                String?
  packagingType           String?
  requestDate             DateTime
  approvalDate            DateTime?
  requestedDeliveryDate   DateTime?
  priority                Priority
  assignedLogisticsUserId String?
  accountOwnerUserId      String?
  approvedByUserId        String?
  internalInstructions    String?
  clientVisibleNotes      String?
  customsNotes            String?
  requiredDocuments       String[]
  attachments             Json?
  deliveryAddress         Json?
  recipient               String?
  recipientPhone          String?
  recipientEmail          String?
  status                  SampleStatus        @default(draft)
  statusHistory           Json?
  createdById             String?
  updatedById             String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  company           Company             @relation(fields: [companyId], references: [id])
  contact           Contact?            @relation(fields: [contactId], references: [id])
  opportunity       Opportunity?        @relation(fields: [opportunityId], references: [id])
  project           ApplicationProject? @relation("ProjectSampleRequests", fields: [projectId], references: [id])
  assignedLogistics User?               @relation("SampleRequestLogistics", fields: [assignedLogisticsUserId], references: [id])
  accountOwner      User?               @relation("SampleRequestAccountOwner", fields: [accountOwnerUserId], references: [id])
  approvedBy        User?               @relation("SampleRequestApprovedBy", fields: [approvedByUserId], references: [id])

