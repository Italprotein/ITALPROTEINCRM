/// Where a follow-up row came from — which is also how much authority it has.
/// `quiet_detection` rows are written by the sync pass and may be refreshed by
/// it; `suppression_list` rows come from the outreach freeze and encode a human
/// decision; `manual` rows were typed in by hand. The sync only ever touches
/// its own `quiet_detection` rows, so neither of the other two can be
/// overwritten by arithmetic.
enum FollowUpSource {
  quiet_detection
  suppression_list
  manual
}

/// What should happen next on a conversation. See model FollowUp.
///
/// `waiting` is the one that carries a date forward: it means the ball is in
/// their court, or a campaign freeze applies, and nobody should chase until
/// `followUpOn`. `pending` is the opposite — the wait is over and it is our
/// move. `contacted` records that we reached out, which restarts the clock.
enum FollowUpStatus {
  pending
  scheduled
  waiting
  contacted
  closed
}

/// How far an investor-outreach conversation has progressed. The four states
/// come from the campaign workbook (assets/Investitori, Criteri sheet):
/// in_contact = personal positive reply, call, NDA or internal forward;
/// to_recontact = out-of-office / auto-reply / dead mailbox; rejected =
/// explicit no; first_contact = mail sent, no signal yet. See model Investor.
enum InvestorStatus {
  in_contact
  to_recontact
  rejected
  first_contact
}

