/**
 * ══════════════════════════════ Gmail sync / leads / auth hardening ══════════════════════════════
 */

// A Gmail message synced into the CRM (inbound inbox mail or outbound mail sent
// from the admin UI). gmailMessageId is the dedupe key across sync runs.
model EmailMessage {
  id                 String         @id @default(cuid())
  gmailMessageId     String         @unique
  gmailThreadId      String
  direction          EmailDirection
  fromAddress        String
  fromName           String?
  toAddresses        String[]
  ccAddresses        String[]
  subject            String?
  snippet            String?
  bodyText           String?
  internalDate       DateTime
  hasAttachments     Boolean        @default(false)
  attachmentNames    String[]
  ndaDetected        Boolean        @default(false)
  ndaId              String?
  matchedAdminUserId String?
  leadId             String?
  companyId          String?
  sentByUserId       String?
  syncedAt           DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  matchedAdmin User?    @relation("EmailMessageMatchedAdmin", fields: [matchedAdminUserId], references: [id], onDelete: SetNull)
  lead         Lead?    @relation("LeadEmailMessages", fields: [leadId], references: [id], onDelete: SetNull)
  // companyId carried no relation until 2026-08-03, so nothing stopped it
  // pointing at a deleted company — production had two such orphans, both from
  // companies auto-created by the Gmail sync and later removed. SetNull matches
  // the lead relation above: losing the company must not delete the mail.
  company      Company? @relation("CompanyEmailMessages", fields: [companyId], references: [id], onDelete: SetNull)

  @@index([direction])
  @@index([internalDate])
  @@index([gmailThreadId])
  @@index([matchedAdminUserId])
  @@index([companyId])
  @@map("email_messages")
}

// "My Leads": one row per responsible member and company extracted from Gmail.
// Ownership is established by the member whose name appears first in the
// counterparty's earliest qualifying incoming message.
model Lead {
  id           String   @id @default(cuid())
  companyName  String
  adminUserId  String
  sourceDomain String?
  source       String   @default("gmail")
  emailCount   Int      @default(1)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  admin    User           @relation("LeadAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)
  messages EmailMessage[] @relation("LeadEmailMessages")

  @@unique([adminUserId, companyName])
  @@index([adminUserId])
  @@map("leads")
}

// Six-digit password-reset codes, stored hashed. A code is valid until
// expiresAt, for at most a fixed number of attempts, and only once.
model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation("UserPasswordResetCodes", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@map("password_reset_codes")
}

// Account invitations use high-entropy, single-use tokens. Only an HMAC hash
// is stored; the plaintext token exists just long enough to build the emailed
// activation link. This is deliberately separate from Auth.js's
// VerificationToken adapter model.
model AccountActivationToken {
  id              String    @id @default(cuid())
  userId          String
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation("UserAccountActivationTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("account_activation_tokens")
}

// Fixed-window rate-limit counters (login, password reset, mail send, sync).
// key encodes scope + subject, e.g. "login:ip:1.2.3.4" or "reset:email:x@y".
model RateLimitEntry {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_entries")
}
