  sampleRequest      SampleRequest @relation("SampleRequestShipments", fields: [sampleRequestId], references: [id])
  company            Company       @relation(fields: [companyId], references: [id])
  confirmedByContact Contact?      @relation("ShipmentConfirmedBy", fields: [confirmedByContactId], references: [id])
  assignedLogistics  User?         @relation("ShipmentLogistics", fields: [assignedLogisticsUserId], references: [id])

  events    ShipmentEvent[] @relation("ShipmentEvents")
  feedbacks Feedback[]      @relation("ShipmentFeedbacks")

  @@index([companyId])
  @@index([sampleRequestId])
  @@index([status])
  @@index([customsStatus])
  @@index([assignedLogisticsUserId])
  @@index([estimatedDelivery])
  @@index([lastTrackedAt])
  @@map("shipments")
}

model ShipmentEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  description String?
  location    String?
  occurredAt  DateTime
  source      String?
  /// The source's own id for this event — the Gmail message id today, a
  /// carrier checkpoint id if a courier API is added. Paired with `source` in
  /// the unique key below, it makes filing an event idempotent, which matters
  /// because the tracking sync re-reads the whole mailbox on every run.
  /// Null for events created by a human; Postgres treats NULLs as distinct, so
  /// those never collide with each other.
  externalId  String?
  rawPayload  Json?
  actorUserId String?
  createdById String?
  updatedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  shipment Shipment @relation("ShipmentEvents", fields: [shipmentId], references: [id], onDelete: Cascade)
  actor    User?    @relation("ShipmentEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([shipmentId, source, externalId])
  @@index([shipmentId])
  @@index([status])
  @@index([occurredAt])
  @@map("shipment_events")
}

